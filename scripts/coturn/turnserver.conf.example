# coturn — terra-server TURN 릴레이 (별도 Lightsail 인스턴스, 서울)
# /etc/turnserver.conf 로 복사 후 <...> 자리를 채운다. 절차: docs/DEPLOYMENT.md "TURN 서버".
#
# 왜 별도 인스턴스인가: 카메라가 고정 2.5Mbps 를 쏘고 TURN 은 in/out 을 둘 다 태워
# 시청 1시간 ≈ 2.2GB. API 서버(2TB/월)와 같은 통에 두면 라이브가 API 를 굶긴다.

listening-port=3478
tls-listening-port=5349
# 앱팀 요청: turns:…:443 (기업망/LTE 에서 443 만 열린 경우). 1024 미만 포트라 서비스에
# CAP_NET_BIND_SERVICE 필요 — Debian 패키지 유닛에 포함돼 있으나 바인드 실패 시 override 로 추가.
alt-tls-listening-port=443

# Lightsail 은 사설 IP + 1:1 NAT. 지정 안 하면 relay 후보가 사설 IP 로 나가 아무도 못 붙는다.
external-ip=<공인 고정 IP>/<사설 IP>

realm=turn.terra-server.uk
fingerprint

# 단기 자격증명(TURN REST API). 서버 .env 의 WEBRTC_TURN_SECRET 과 반드시 같은 값.
use-auth-secret
static-auth-secret=<openssl rand -hex 32>

# relay 포트 — Lightsail 네트워킹 탭에서 이 범위를 UDP 로 열어야 한다.
min-port=49152
max-port=65535

cert=/etc/letsencrypt/live/turn.terra-server.uk/fullchain.pem
pkey=/etc/letsencrypt/live/turn.terra-server.uk/privkey.pem
no-tlsv1
no-tlsv1_1

# 열린 릴레이로 악용 방지 — 사설 대역·루프백으로의 relay 금지
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255

no-cli
log-file=/var/log/turnserver.log
simple-log

# 세션당 대역 상한(옵션). 카메라 2.5Mbps + 재전송 여유. 필요해지면 주석 해제.
# max-bps=4000000
# user-quota=4          # 사용자당 동시 세션
# total-quota=40
